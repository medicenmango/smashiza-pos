	column Ingrediente_Id
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: b22ee35f-4fd9-4be8-c70f-c56477d16d9c
		summarizeBy: none
		sourceColumn: Ingrediente_Id

		annotation SummarizationSetBy = Automatic

	column 'A comprar' =
			VAR Actual = IF ( ISBLANK ( Inventario[Stock] ), 0, Inventario[Stock] )
			VAR Meta =
			    IF (
			        NOT ISBLANK ( Inventario[Ideal] ),
			        Inventario[Ideal],
			        Inventario[Minimo]
			    )
			RETURN
			    IF ( ISBLANK ( Meta ), BLANK (), IF ( Actual < Meta, Meta - Actual, BLANK () ) )
		dataType: int64
		formatString: #,0
		lineageTag: e21a0001-0001-4aaa-8001-inventario0001
		summarizeBy: none

		annotation SummarizationSetBy = User

	column EstadoOrden =
			VAR Actual = IF ( ISBLANK ( Inventario[Stock] ), 0, Inventario[Stock] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Inventario[Minimo] ) && ISBLANK ( Inventario[Ideal] ), 4,
			        NOT ISBLANK ( Inventario[Minimo] ) && Actual < Inventario[Minimo], 1,
			        NOT ISBLANK ( Inventario[Ideal] ) && Actual < Inventario[Ideal], 2,
			        3
			    )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e21a0001-0003-4aaa-8003-inventario0003
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Estado =
			SWITCH (
			    Inventario[EstadoOrden],
			    1, "Comprar ya",
			    2, "Reponer",
			    4, "Sin meta",
			    "Ok"
			)
		dataType: string
		lineageTag: e21a0001-0002-4aaa-8002-inventario0002
		summarizeBy: none
		sortByColumn: EstadoOrden

		annotation SummarizationSetBy = User

