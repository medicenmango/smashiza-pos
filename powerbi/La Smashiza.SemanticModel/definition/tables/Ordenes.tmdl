	column Hora_Dia = IF ( ISBLANK ( Ordenes[Hora] ), BLANK (), HOUR ( Ordenes[Hora] ) )
		dataType: int64
		formatString: 00
		lineageTag: b9e42d3f-5c78-4e01-af2b-7d6e1c9f4b32
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Fecha_Turno =
			IF (
			    NOT ISBLANK ( Ordenes[Hora] ) && HOUR ( Ordenes[Hora] ) <= 1,
			    Ordenes[Fecha] - 1,
			    Ordenes[Fecha]
			)
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: c0a53e40-6d89-4f12-b043-8e7f2d0a5b64
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

