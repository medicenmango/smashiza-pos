	partition Recetas = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("C:\Users\cjgz\OneDrive - Universidad Autonoma de Guadalajara\SMASHIZA\Smashiza Ordenes.xlsx"), null, true),
				  Sheets = Table.SelectRows(Source, each [Item] = "Recetas" and [Kind] = "Sheet"),
				  Empty = #table(type table [Producto = text, Ingrediente = text, Cantidad = number, Unidad = text], {}),
				  Base = if Table.RowCount(Sheets) = 0 then Empty else
				    let
				      Data = Sheets{0}[Data],
				      Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars = true]),
				      Typed = Table.TransformColumnTypes(Promoted, {{"Producto", type text}, {"Ingrediente", type text}, {"Cantidad", type number}, {"Unidad", type text}})
				    in
				      Typed,
				  Clave = (v as any) as text => Text.Lower(Text.Trim(if v = null then "" else Text.From(v))),
				  ConClaveProd = Table.AddColumn(Base, "_ProductoClave", each Clave([Producto]), type text),
				  MenuBase = Table.SelectColumns(Menu, {"Id", "Nombre"}),
				  MenuClave = Table.AddColumn(MenuBase, "_ProductoClave", each Clave([Nombre]), type text),
				  MenuUnica = Table.Distinct(Table.SelectRows(Table.SelectColumns(MenuClave, {"Id", "_ProductoClave"}), each [_ProductoClave] <> ""), {"_ProductoClave"}),
				  MergeProd = Table.NestedJoin(ConClaveProd, {"_ProductoClave"}, MenuUnica, {"_ProductoClave"}, "MenuMatch", JoinKind.LeftOuter),
				  ExpandProd = Table.ExpandTableColumn(MergeProd, "MenuMatch", {"Id"}, {"Producto_Id"}),
				  ConClaveIng = Table.AddColumn(ExpandProd, "_IngredienteClave", each Clave([Ingrediente]), type text),
				  InvBase = Table.SelectColumns(Inventario, {"Ingrediente_Id", "Nombre"}),
				  InvClave = Table.AddColumn(InvBase, "_IngredienteClave", each Clave([Nombre]), type text),
				  InvUnica = Table.Distinct(Table.SelectRows(Table.SelectColumns(InvClave, {"Ingrediente_Id", "_IngredienteClave"}), each [_IngredienteClave] <> ""), {"_IngredienteClave"}),
				  MergeIng = Table.NestedJoin(ConClaveIng, {"_IngredienteClave"}, InvUnica, {"_IngredienteClave"}, "InvMatch", JoinKind.LeftOuter),
				  ExpandIng = Table.ExpandTableColumn(MergeIng, "InvMatch", {"Ingrediente_Id"}, {"Ingrediente_Id"}),
				  Final = Table.RemoveColumns(ExpandIng, {"_ProductoClave", "_IngredienteClave"})
				in
				  Final

	annotation PBI_ResultType = Table

