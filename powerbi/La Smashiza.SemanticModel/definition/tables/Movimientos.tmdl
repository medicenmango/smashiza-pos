	partition Movimientos = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("C:\Users\cjgz\OneDrive - Universidad Autonoma de Guadalajara\SMASHIZA\Smashiza Ordenes.xlsx"), null, true),
				  Sheets = Table.SelectRows(Source, each [Item] = "Movimientos" and [Kind] = "Sheet"),
				  Empty = #table(type table [Fecha = date, Hora = time, Tipo = text, Ingrediente = text, Cantidad = number, Unidad = text, Num_Orden = number, Nota = text], {}),
				  Result = if Table.RowCount(Sheets) = 0 then Empty else
				    let
				      Data = Sheets{0}[Data],
				      Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars = true]),
				      NullOrden = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Num_Orden"}),
				      Typed = Table.TransformColumnTypes(NullOrden, {{"Fecha", type date}, {"Hora", type time}, {"Tipo", type text}, {"Ingrediente", type text}, {"Cantidad", type number}, {"Unidad", type text}, {"Num_Orden", Int64.Type}, {"Nota", type text}})
				    in
				      Typed,
				  Clave = (v as any) as text => Text.Lower(Text.Trim(if v = null then "" else Text.From(v))),
				  ConClave = Table.AddColumn(Result, "_IngredienteClave", each Clave([Ingrediente]), type text),
				  InvBase = Table.SelectColumns(Inventario, {"Ingrediente_Id", "Nombre"}),
				  InvClave = Table.AddColumn(InvBase, "_IngredienteClave", each Clave([Nombre]), type text),
				  InvUnica = Table.Distinct(Table.SelectRows(Table.SelectColumns(InvClave, {"Ingrediente_Id", "_IngredienteClave"}), each [_IngredienteClave] <> ""), {"_IngredienteClave"}),
				  MergeIng = Table.NestedJoin(ConClave, {"_IngredienteClave"}, InvUnica, {"_IngredienteClave"}, "InvMatch", JoinKind.LeftOuter),
				  ExpandIng = Table.ExpandTableColumn(MergeIng, "InvMatch", {"Ingrediente_Id"}, {"Ingrediente_Id"}),
				  Final = Table.RemoveColumns(ExpandIng, {"_IngredienteClave"})
				in
				  Final

	annotation PBI_ResultType = Table

